{
  "model_selection_basis": "EXP-012 temporal cross-validation",
  "target": "log(posted_rate / distance)",
  "prediction_reconstruction": "exp(predicted_log_rpm) * distance",
  "features": [
    "pickup",
    "delivery",
    "pickup_lat",
    "pickup_lon",
    "delivery_lat",
    "delivery_lon",
    "distance",
    "equipment",
    "weight",
    "market_index",
    "quote_signal"
  ],
  "categorical_columns": [
    "pickup",
    "delivery",
    "equipment"
  ],
  "numerical_columns": [
    "pickup_lat",
    "pickup_lon",
    "delivery_lat",
    "delivery_lon",
    "distance",
    "weight",
    "market_index",
    "quote_signal"
  ],
  "preprocessing": {
    "numeric_imputation": "median",
    "categorical_imputation": "most_frequent",
    "one_hot_handle_unknown": "ignore",
    "negative_weight_handling": "weight < 0 -> NaN"
  },
  "model": {
    "type": "ExtraTreesRegressor",
    "n_estimators": 100,
    "min_samples_leaf": 20,
    "random_state": 42,
    "n_jobs": -1
  },
  "training_data": {
    "file": "data/train-test.csv",
    "rows": 48000,
    "date_start": "2025-01-01",
    "date_end": "2025-10-31"
  },
  "prediction_data": {
    "file": "data/validation.csv",
    "rows": 12000,
    "date_start": "2025-11-01",
    "date_end": "2025-12-31"
  }
}